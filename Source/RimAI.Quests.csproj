<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 and nothing older. 1.7 is not a Unity player: it runs on
    .NET 10, its assemblies sit in the game folder itself, and one assembly -
    UnityStubs - stands in for everything that was UnityEngine.*Module.dll.
    So this is net10.0 and compiles against that stand-in, which turns a
    Unity member 1.7 does not have into a compile error here instead of a
    type that fails to load there. The 1.6 build is the tag
    rimworld-1.6-final.
  -->

    <PropertyGroup>
        <GameVersion Condition=" '$(GameVersion)' == '' ">1.7</GameVersion>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- The game loads a mod assembly from the mod's own folder: no deps
             file beside it. A package this mod ships has to reach the output. -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <RootNamespace>Ustas.RimAI.Quests</RootNamespace>
        <AssemblyName>RimAI.Quests</AssemblyName>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

        <RimWorldDir Condition=" '$(RimWorldDir)' == '' ">$(RIMWORLD_DIR)</RimWorldDir>
        <RimWorldWorkshopDir Condition=" '$(RimWorldWorkshopDir)' == '' ">$(RIMWORLD_WORKSHOP_DIR)</RimWorldWorkshopDir>

        <BaseOutputPath Condition=" '$(BaseOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Quests\bin\</BaseOutputPath>
        <BaseIntermediateOutputPath Condition=" '$(BaseIntermediateOutputPath)' == '' ">$(LOCALAPPDATA)\Ustas\RimWorldSourceBuilds\RimAI.Quests\obj\</BaseIntermediateOutputPath>
        <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
        <ModFolderName>RimAI.Quests</ModFolderName>
        <!-- Module package root (csproj lives under Source/) -->
        <ModRoot>$(MSBuildProjectDirectory)\..</ModRoot>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- Define version constants based on GameVersion -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants);V$(GameVersion.Replace('.', '_'))</DefineConstants>
    </PropertyGroup>

    <!-- Release build configuration -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <Optimize>true</Optimize>
        <DebugSymbols>false</DebugSymbols>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <!-- Debug build configuration -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <Optimize>false</Optimize>
        <DebugSymbols>true</DebugSymbols>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" ExcludeAssets="runtime" PrivateAssets="All" />
        <ProjectReference Include="..\..\RimAI.Core\src\RimAI.Core\RimAI.Core.csproj">
            <Private>false</Private>
        </ProjectReference>
        <ProjectReference Include="..\..\RimAI.Core\src\RimAI.RimWorld\RimAI.RimWorld.csproj">
            <Private>false</Private>
        </ProjectReference>
        <ProjectReference Include="..\..\RimAI.Communication\Source\RimAI.Communication.csproj">
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>

    <!-- Use reference assemblies by default (for other users and CI) -->
    <ItemGroup Condition=" '$(UseLocalDlls)' != 'true' ">
        <!-- Core RimWorld & UnityEngine libraries -->
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(GameVersion).*-*" PrivateAssets="All" />
    </ItemGroup>

    <!-- Reference actual game assemblies when UseLocalDlls is enabled -->
    <ItemGroup Condition=" '$(UseLocalDlls)' == 'true' AND '$(RimWorldDir)' != '' ">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Waylith"><HintPath>$(RimWorldDir)\Waylith.dll</HintPath><Private>false</Private></Reference>


    </ItemGroup>

    <!-- Exclude ref directory from compilation -->
    <ItemGroup>
        <Compile Remove="..\ref\**" />
        <EmbeddedResource Remove="..\ref\**" />
        <None Remove="..\ref\**" />
        <Compile Remove="..\tests\**" />
        <EmbeddedResource Remove="..\tests\**" />
        <None Remove="..\tests\**" />
    </ItemGroup>

    <!-- Deploy to RimWorld client -->
    <Target Name="DeployToModsFolder" AfterTargets="Build" Condition=" '$(BuildingWithScript)' != 'true' AND '$(RimWorldDir)' != '' ">
        <CallTarget Targets="WinDeploy" Condition=" '$(OS)' == 'Windows_NT' "/>
        <CallTarget Targets="MacDeploy" Condition=" '$(OS)' != 'Windows_NT' "/>
    </Target>

    <!-- Stage primary assembly into versioned Assemblies before MIR. -->
    <Target Name="StageModAssemblies">
        <MakeDir Directories="$(ModRoot)\$(GameVersion)\Assemblies" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModRoot)\$(GameVersion)\Assemblies\" SkipUnchangedFiles="true" />
    </Target>

    <!-- Deploy to RimWorld client (macOS) -->
    <Target Name="MacDeploy" DependsOnTargets="StageModAssemblies">
        <PropertyGroup>
            <DeployPath>$(RimWorldDir)/RimWorldMac.app/Mods/$(ModFolderName)/</DeployPath>
        </PropertyGroup>
        <MakeDir Directories="$(DeployPath)"/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/About/"     "$(DeployPath)About/"'/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/Defs/"      "$(DeployPath)Defs/"' Condition="Exists('$(ModRoot)\Defs')"/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/Languages/" "$(DeployPath)Languages/"' Condition="Exists('$(ModRoot)\Languages')"/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/Textures/"  "$(DeployPath)Textures/"' Condition="Exists('$(ModRoot)\Textures')"/>
        <Exec Command='rsync -a --delete --checksum "$(ModRoot)/$(GameVersion)/"       "$(DeployPath)$(GameVersion)/"'/>
        <Message Text="--- macOS deployment finished successfully ---" Importance="high"/>
    </Target>

    <!-- Deploy to RimWorld client (Windows) -->
    <Target Name="WinDeploy" DependsOnTargets="StageModAssemblies">
        <PropertyGroup>
            <WinModPath>$(RimWorldDir)\Mods\$(ModFolderName)\</WinModPath>
        </PropertyGroup>
        <Message Text="Copying to $(WinModPath)" Importance="high"/>
        <ItemGroup>
            <_CopyDirs Include="About;$(GameVersion)"/>
            <_CopyDirs Include="Defs" Condition="Exists('$(ModRoot)\Defs')"/>
            <_CopyDirs Include="Languages" Condition="Exists('$(ModRoot)\Languages')"/>
            <_CopyDirs Include="Textures" Condition="Exists('$(ModRoot)\Textures')"/>
        </ItemGroup>
        <MakeDir Directories="$(WinModPath)"/>
        <Exec Command='robocopy /MIR "$(ModRoot)\%(_CopyDirs.Identity)" "$(WinModPath)%(_CopyDirs.Identity)" /XO /NDL /NJH /NJS /nc /ns /np'
              IgnoreExitCode="true"
              ContinueOnError="true"/>
        <Message Text="--- Windows deployment finished successfully ---" Importance="high"/>
    </Target>

</Project>


